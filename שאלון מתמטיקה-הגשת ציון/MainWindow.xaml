<Window x:Class="שאלון_מתמטיקה_הגשת_ציון.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:שאלון_מתמטיקה_הגשת_ציון"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="WhiteSmoke">

        <Grid x:Name="opening" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.5*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>
            <Image Source="/images/backgrand1.png" Grid.ColumnSpan="4" Grid.RowSpan="4" Stretch="Fill"/>
            <TextBlock Text="ברוכים הבאים" FontWeight="Bold" FontSize="80" Grid.Row="1" 
                       Grid.Column="1" Grid.ColumnSpan="2"/>
            <Button Content="התחל" FontSize="25" Height="60" Width="170" Grid.Row="2" 
                    Grid.Column="1" Grid.ColumnSpan="2" Click="Targil"/>
            <Image Source="/images/smart_dog.png" Grid.Row="2" Grid.RowSpan="2" 
                   Grid.ColumnSpan="2" Panel.ZIndex="1"/>

        </Grid>

        <Grid x:Name="shelon" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.5*"/>
                <RowDefinition Height="1.5*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.5*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.6*"/>
            </Grid.ColumnDefinitions>

            <Image Source="/images/checking_guy.png" Grid.Column="5" Grid.ColumnSpan="2"/>
            <Image Source="/images/smart_cat.png" Grid.ColumnSpan="2"/>

            <TextBlock Text="שאלון" FontWeight="Heavy" FontSize="85" Grid.Column="2" Grid.ColumnSpan="3"
           HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="5" Grid.Column="1">
                <TextBlock Height="70" Width="90" FontSize="50" Margin="50,0,0,0" x:Name="num1"/>
                <TextBlock Height="70" Width="90" FontSize="50" Margin="20,0,0,0" x:Name="peula"/>
                <TextBlock Height="70" Width="90" FontSize="50" Margin="20,0,0,0"  x:Name="num2"/>
                <TextBlock Text="=" FontSize="65" Height="70" Width="90" Margin="20,0,0,0"/>
                <TextBox Height="70" Width="90" FontSize="50" Margin="20,0,0,0" x:Name="user_ans"/>
            </StackPanel>

            <Button Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" Height="60" Width="150" 
        Content="בדיקה" FontSize="30" Click="Bdika_ans" x:Name="check"/>

            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" 
           FontSize="50" Text="תשובה נכונה" Visibility="Collapsed" x:Name="right"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" 
           FontSize="50" Text="תשובה לא נכונה" Visibility="Collapsed" x:Name="wrong"/>
            <Button Content="תרגיל הבא" FontSize="25" Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" 
                    Height="60" Width="150" Click="Targil" Visibility="Collapsed" x:Name="next_trgil"/>
        </Grid>
        <Grid x:Name="finle_gread" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock HorizontalAlignment="Center" FontSize="50" VerticalAlignment="Center" 
                       Grid.ColumnSpan="2" Grid.Row="1" x:Name="idk" />
            <Image Source="/images/צילום מסך 2026-11-06 232654.png" Grid.Column="2" 
                   Grid.Row="1" Grid.RowSpan="2"/>

            <Image Source="/images/thumbs-up.png" Grid.Row="2" x:Name="happy" Visibility="Collapsed"/>
            
            <TextBlock Text="!בפעם הבאה תצליח/י יותר" FontWeight="Bold" FontSize="50" 
                       Grid.ColumnSpan="3" HorizontalAlignment="Center"
                       x:Name="sad" Visibility="Collapsed"/>

        </Grid>

    </Grid>
</Window>
